{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{3,64}$"},
    "implemented_files": {"type": "array", "items": {"type": "string"}},
    "train_contract": {"type": "boolean"},
    "load_contract": {"type": "boolean"},
    "predict_contract": {"type": "boolean"},
    "external_weights": {"type": "array", "items": {"type": "string"}},
    "new_dependencies": {"type": "array", "items": {"type": "string"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["schema_version", "candidate_id", "implemented_files", "train_contract", "load_contract", "predict_contract", "external_weights", "new_dependencies", "caveats"]
}
