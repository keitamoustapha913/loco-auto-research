[Unit]
Description=LOCO Autoresearch MLflow tracking (loopback only)
After=network.target
[Service]
Type=simple
User=loco-operator
WorkingDirectory=/opt/loco-autoresearch
EnvironmentFile=/etc/loco-autoresearch.env
ExecStart=/opt/loco-autoresearch/scripts/start_mlflow.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
