[Unit]
Description=LOCO trusted single-GPU worker — operator config required
After=network.target
[Service]
Type=oneshot
User=loco-worker
WorkingDirectory=/opt/loco-autoresearch
EnvironmentFile=/etc/loco-autoresearch.env
ExecStart=/opt/loco-autoresearch/.venv/bin/python -m orchestrator.controller worker-once --manifest /srv/loco-runtime/good_manifest.json
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
# Operator: configure protected mounts, cgroups and restricted candidate execution before enabling.
