[Unit]
Description=LOCO Research read-only Streamlit dashboard (loopback only)
After=loco-mlflow.service
[Service]
Type=simple
User=loco-dashboard
WorkingDirectory=/opt/loco-autoresearch
EnvironmentFile=/etc/loco-autoresearch.env
ExecStart=/opt/loco-autoresearch/.venv/bin/streamlit run dashboard/app.py --server.address 127.0.0.1 --server.port 8501
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
